rules_version = '2';

// Guardião — regras de segurança do Firestore.
//
// Quem é quem:
//  - Responsável: conta com e-mail e senha (provedor "password").
//  - Filho: login anônimo; o uid dele é o id do documento em /devices.
//
// Vínculo: o aparelho do filho gera um código (QR) em /pairRequests; o
// responsável o lê e, num único lote, queima o pedido e cria o aparelho dele
// em /devices. Um responsável pode vincular quantos aparelhos quiser.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isParentAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function deviceDoc(deviceId) {
      return get(/databases/$(database)/documents/devices/$(deviceId)).data;
    }

    function isAnonymous() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function pairRequest(code) {
      return get(/databases/$(database)/documents/pairRequests/$(code)).data;
    }

    function pairRequestAfter(code) {
      return getAfter(/databases/$(database)/documents/pairRequests/$(code)).data;
    }

    function isParentOf(deviceId) {
      return isParentAccount() && deviceDoc(deviceId).parentUid == request.auth.uid;
    }

    // ---------- Pedidos de vínculo (gerados pelo aparelho do filho) ----------
    match /pairRequests/{code} {
      // Qualquer conta logada lê UM pedido por vez (não há listagem).
      // O código tem 8 caracteres e vale 10 minutos.
      allow get: if signedIn();

      // O aparelho do filho cria o pedido em nome dele.
      allow create: if isAnonymous()
        && request.resource.data.keys().hasOnly(['deviceId', 'name', 'platform', 'expiresAt', 'used'])
        && request.resource.data.deviceId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.platform in ['android', 'windows', 'other']
        && request.resource.data.used == false
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(15, 'm');

      // O responsável "queima" o pedido uma única vez, antes de expirar,
      // registrando o próprio uid.
      allow update: if isParentAccount()
        && resource.data.used == false
        && request.time < resource.data.expiresAt
        && request.resource.data.used == true
        && request.resource.data.parentUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'parentUid']);

      // Só o aparelho que gerou o código pode cancelá-lo.
      allow delete: if signedIn() && resource.data.deviceId == request.auth.uid;
    }

    // ---------- Dispositivos ----------
    match /devices/{deviceId} {
      allow read: if signedIn()
        && (request.auth.uid == deviceId || resource.data.parentUid == request.auth.uid);

      // Vínculo: o RESPONSÁVEL cria o documento do aparelho, no mesmo lote
      // que queima o pedido de vínculo gerado por ele (o filho).
      allow create: if isParentAccount()
        && request.resource.data.keys().hasOnly(
             ['parentUid', 'parentLabel', 'name', 'platform', 'pairingCode', 'pairedAt', 'lastSeen'])
        && request.resource.data.parentUid == request.auth.uid
        && (!('parentLabel' in request.resource.data)
            || (request.resource.data.parentLabel is string
                && request.resource.data.parentLabel.size() <= 80))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.platform in ['android', 'windows', 'other']
        && pairRequest(request.resource.data.pairingCode).deviceId == deviceId
        && pairRequest(request.resource.data.pairingCode).used == false
        && request.time < pairRequest(request.resource.data.pairingCode).expiresAt
        && pairRequest(request.resource.data.pairingCode).platform == request.resource.data.platform
        && pairRequestAfter(request.resource.data.pairingCode).used == true
        && pairRequestAfter(request.resource.data.pairingCode).parentUid == request.auth.uid;

      // O aparelho só atualiza "lastSeen" (batimento) e "health" (situação das
      // proteções); o responsável só o nome.
      allow update: if signedIn() && (
        (request.auth.uid == deviceId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'health'])
          && (!('health' in request.resource.data)
              || (request.resource.data.health is map
                  && request.resource.data.health.keys().hasOnly(
                       ['usageAccess', 'overlay', 'notifications', 'admin', 'monitorRunning', 'checkedAt'])
                  && request.resource.data.health.usageAccess is bool
                  && request.resource.data.health.overlay is bool
                  && request.resource.data.health.notifications is bool
                  && request.resource.data.health.admin is bool
                  && request.resource.data.health.monitorRunning is bool)))
        || (resource.data.parentUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']))
      );

      allow delete: if isParentAccount() && resource.data.parentUid == request.auth.uid;

      // Aplicativos instalados: só o próprio aparelho escreve; o responsável lê.
      match /apps/{appId} {
        allow read: if signedIn()
          && (request.auth.uid == deviceId || isParentOf(deviceId));
        allow create, update: if signedIn() && request.auth.uid == deviceId
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 200;
        // O responsável pode limpar tudo ao desvincular o aparelho.
        allow delete: if signedIn() && (request.auth.uid == deviceId || isParentOf(deviceId));
      }

      // Tempo de uso por dia e aplicativo: só o próprio aparelho escreve; o
      // responsável lê. O id do documento é "{dia}_{appId}".
      match /usage/{usageId} {
        allow read: if signedIn()
          && (request.auth.uid == deviceId || isParentOf(deviceId));
        allow create, update: if signedIn() && request.auth.uid == deviceId
          && request.resource.data.keys().hasOnly(['day', 'appId', 'minutes', 'updatedAt'])
          && request.resource.data.day is string
          && request.resource.data.day.size() == 10
          && request.resource.data.appId is string
          && request.resource.data.appId.size() <= 120
          && request.resource.data.minutes is int
          && request.resource.data.minutes >= 0
          && request.resource.data.minutes <= 1440;
        allow delete: if signedIn() && (request.auth.uid == deviceId || isParentOf(deviceId));
      }

      // Avisos de burla (permissão retirada, administrador desativado...): o
      // aparelho cria, o responsável lê, marca como visto e apaga.
      match /alerts/{alertId} {
        allow read: if isParentOf(deviceId);
        allow create: if signedIn() && request.auth.uid == deviceId
          && request.resource.data.keys().hasOnly(['kind', 'at', 'seen'])
          && request.resource.data.kind in [
               'usage_access_revoked', 'overlay_revoked', 'notifications_revoked',
               'admin_disabled', 'monitor_stopped']
          && request.resource.data.at == request.time
          && request.resource.data.seen == false;
        allow update: if isParentOf(deviceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen'])
          && request.resource.data.seen == true;
        allow delete: if isParentOf(deviceId);
      }

      // Regras por aplicativo: só o responsável escreve; o aparelho lê.
      match /rules/{appId} {
        allow read: if signedIn()
          && (request.auth.uid == deviceId || isParentOf(deviceId));
        allow create, update: if isParentOf(deviceId)
          && request.resource.data.blocked is bool
          && (request.resource.data.dailyLimitMinutes == null
              || (request.resource.data.dailyLimitMinutes is int
                  && request.resource.data.dailyLimitMinutes >= 0
                  && request.resource.data.dailyLimitMinutes <= 1440));
        allow delete: if isParentOf(deviceId);
      }
    }

    // Todo o resto é negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
